---
import "../styles/site.css";
import Icon from "../components/Icons.astro";
import { compact, REPO_URL, RELEASES_URL, repoStats } from "../lib/github";

interface Props { title: string; description: string }
const { title, description } = Astro.props;
const stats = await repoStats();
const site = Astro.site;
const ogImage = site ? new URL("/icons/icon-512.png", site).href : "/icons/icon-512.png";
const docs = (p: string) => `${REPO_URL}/blob/main/${p}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content="Needs You" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {site && <meta property="og:url" content={site.href} />}
    {site && <link rel="canonical" href={site.href} />}
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/Inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("ny-theme");
          if (t === "light" || t === "dark") {
            document.documentElement.dataset.theme = t;
            document.documentElement.style.colorScheme = t;
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="ny">
      <a class="ny-sr" href="#main">Skip to content</a>
      <header class="ny-header">
        <div class="ny-header-inner">
          <a href="/" class="ny-brand" aria-label="Needs You, home">
            <img src="/icons/icon-64.png" alt="" width="28" height="28" />
            Needs You
          </a>
          <div class="ny-header-actions">
            <a class="ny-btn ny-btn-sm ny-btn-secondary" href={REPO_URL} aria-label="Needs You on GitHub">
              <Icon name="github" />
              <span class="ny-hide-sm">GitHub</span>
              <span class="ny-count" data-stat="stars" hidden={!stats.stars}>{stats.stars ? compact(stats.stars) : ""}</span>
            </a>
            <a class="ny-btn ny-btn-sm ny-btn-primary" href={stats.dmgUrl} data-dmg>Download</a>
          </div>
        </div>
      </header>
      <main class="ny-main" id="main"><slot /></main>
      <footer class="ny-footer">
        <div class="ny-footer-inner">
          <div class="ny-footer-cols">
            <ul>
              <li><a href="#ask">Questions out loud</a></li>
              <li><a href="#hey-claude">Hey Claude</a></li>
              <li><a href="#voicemail">Voicemail</a></li>
              <li><a href="#privacy">Privacy</a></li>
              <li><a href="#faq">FAQ</a></li>
            </ul>
            <ul>
              <li><a href={REPO_URL}>GitHub</a></li>
              <li><a href={RELEASES_URL}>Releases</a></li>
              <li><a href={docs("docs/agents.md")}>Docs for agents</a></li>
              <li><a href={docs("docs/privacy.md")}>Privacy details</a></li>
              <li><a href={docs("ACKNOWLEDGEMENTS.md")}>Credits</a></li>
            </ul>
            <div class="ny-maker">
              <a href="https://homemade.dev" aria-label="Homemade" style="flex:none">
                <img class="ny-logo-light" src="/brand/homemade-on-light.svg" alt="" width="40" height="40" loading="lazy" />
                <img class="ny-logo-dark" src="/brand/homemade-on-dark.svg" alt="" width="40" height="40" loading="lazy" />
              </a>
              <p>Made by <a href="https://homemade.dev">Homemade</a></p>
            </div>
          </div>
          <div class="ny-footer-bottom">
            <p>© 2026 Homemade</p>
            <fieldset class="ny-theme">
              <legend class="ny-sr">Appearance</legend>
              <button type="button" data-theme-choice="system" aria-label="Match system" title="Match system" aria-pressed="true">
                <svg viewBox="0 0 18 18" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="9" cy="9" r="6.5" /><path d="M9 2.5a6.5 6.5 0 0 0 0 13z" fill="currentColor" stroke="none" /></svg>
              </button>
              <button type="button" data-theme-choice="light" aria-label="Light" title="Light" aria-pressed="false">
                <svg viewBox="0 0 18 18" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="9" r="3.2" /><path d="M9 1.5v2M9 14.5v2M1.5 9h2M14.5 9h2M3.7 3.7l1.4 1.4M12.9 12.9l1.4 1.4M3.7 14.3l1.4-1.4M12.9 5.1l1.4-1.4" /></svg>
              </button>
              <button type="button" data-theme-choice="dark" aria-label="Dark" title="Dark" aria-pressed="false">
                <svg viewBox="0 0 18 18" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M15 10.6A6.6 6.6 0 0 1 7.4 3a6.6 6.6 0 1 0 7.6 7.6z" /></svg>
              </button>
            </fieldset>
          </div>
        </div>
      </footer>
    </div>
    <script>
      import "../scripts/page";
    </script>
  </body>
</html>
