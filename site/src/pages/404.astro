---
import Base from "../layouts/Base.astro";
---
<Base
  title="Page not found · Needs You"
  description="This page doesn't exist on the Needs You web site."
  noindex
>
  <section class="ny-section ny-col ny-end">
    <img src="/icons/icon-256.png" alt="" width="96" height="96" />
    <h1>This page doesn't exist.</h1>
    <p class="ny-subhead">The link may be old or mistyped.</p>
    <p class="ny-actions">
      <a class="ny-btn ny-btn-primary" href="/">Go to the home page</a>
    </p>
  </section>
</Base>
