// Generated by Project Doctor
{
  "$schema": "https://www.homemade.dev/schemas/latest/config.json",
  // Only the Astro web site (site/) runs here. The macOS app (Swift, Sources/)
  // needs Xcode and macOS, so it is not built on this Linux computer.
  "warmup": ["cd site && pnpm install --frozen-lockfile"],
  "install": ["cd site && pnpm install --frozen-lockfile"],
  "services": {
    "site": {
      "cmd": "cd site && exec pnpm exec astro dev --host 0.0.0.0 --port $PORT",
      "port": 4321,
      "url": true,
      "healthcheck": { "path": "/" },
      "displayName": "Web site"
    }
  }
}
